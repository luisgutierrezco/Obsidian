FROM  REP_FMT_INVENTORY_OPERATION(
'LOAD',
$P{P_INITIAL_DATE},
$P{P_FINAL_DATE},
$P{P_INITIAL_DOCUMENT},
$P{P_FINAL_DOCUMENT},
$P{P_LIST_DOCUMENTS},
$P{P_USER}) K]]>
